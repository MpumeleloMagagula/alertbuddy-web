# Alert Buddy Backend Configuration

# Server Port
PORT=5000

# Firebase Service Account Key (JSON string)
# Get this from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Copy the entire JSON content and paste it as a single line here
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ── Tenant ───────────────────────────────────────────────────────────────────
# Alert Buddy is deployed one client per instance. This value is stamped onto
# every Firestore document (defence-in-depth + forward-compat). Lower-case slug.
TENANT_ID=default

# ── Monitoring webhook credentials (gateway) ──────────────────────────────────
# These are BOOTSTRAP fallbacks. Once the server can reach Firestore the live
# values come from the config/webhook document, editable in Settings → Integrations.
# At least one style must be resolvable or all webhook requests are rejected.
#
# HTTP Basic — Grafana contact points, Zabbix HTTP media type:
WEBHOOK_USER=alertbuddy
WEBHOOK_PASSWORD=change-me-to-a-long-random-string
#
# Bearer token — Zabbix webhook media type header, curl, custom scripts:
WEBHOOK_TOKEN=change-me-to-a-long-random-string
#
# Path token — /api/webhooks/zabbix/<token>, for systems that can't set a header:
WEBHOOK_TENANT_TOKEN=

# Legacy vars (still honoured for existing Grafana setups — prefer WEBHOOK_* above):
# GRAFANA_WEBHOOK_USER=grafana
# GRAFANA_WEBHOOK_PASSWORD=change-me
